<h1>New Member</h1>

<%= form_with url: members_path, method: :post do |f| %>

  <div class="mb-3">

    <%= f.label :email %>

    <%= f.email_field :email,
        class: "form-control" %>

  </div>

  <div class="mb-3">

    <%= f.label :paasword %>

    <%= f.password_field :password,
        class: "form-control" %>

  </div>

  <%= f.submit "Create user and invite",
      class: "btn btn-primary" %>

<% end %>