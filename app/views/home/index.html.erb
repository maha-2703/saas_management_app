<% if current_user %>

  <!-- TOP SECTION -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <h2>
      Organization:
      <%= current_user.organization_name %>
    </h2>
<%= link_to "Add Members",
        new_member_path,
        class: "btn btn-primary" %>

  </div>

  <!-- COMPANY PROJECTS TABLE KEELA VARUM -->
  <%= render 'company_projects/index' %>

<% else %>

  <div class="jumbotron text-white p-5 rounded"
       style="background: url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?q=80&w=1200') center center/cover no-repeat;">

    <h1 class="display-5 fw-bold">
      Welcome to the Project Management Application!
    </h1>

    <p class="lead">
      You'll love managing your project with our SaaS application.
    </p>

  </div>

  <div class="row text-center mt-5">

    <div class="col-md-6">

      <h2>Free Plan</h2>

      <ul class="list-unstyled mt-4">
        <li>Unlimited file uploads</li>
        <li>Responsive design</li>
        <li>Access anywhere</li>
        <li>1 project</li>
      </ul>

      <h4>Price: Free</h4>

      <%= link_to "Sign Up",
          new_user_registration_path(plan: "free"),
          class: "btn btn-success mt-3" %>

    </div>

    <div class="col-md-6">

      <h2>Premium Plan</h2>

      <ul class="list-unstyled mt-4">
        <li>Unlimited file uploads</li>
        <li>Responsive design</li>
        <li>Access anywhere</li>
        <li>Unlimited projects</li>
      </ul>

      <h4>Price: $10</h4>

      <%= link_to "Sign Up",
          new_user_registration_path(plan: "premium"),
          class: "btn btn-primary mt-3" %>

    </div>

  </div>

<% end %>