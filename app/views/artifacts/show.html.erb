<%- model_class = Artifact -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="row">
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:name) %>:</dt>
  <dd class="col-sm-10"><%= @artifact.name %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:key) %>:</dt>
  <dd class="col-sm-10"><%= @artifact.key %></dd>
  <dt class="col-sm-2"><%= model_class.human_attribute_name(:company_project_id) %>:</dt>
  <dd class="col-sm-10"><%= @artifact.company_project_id %></dd>
</dl>

<%= link_to t('.back', :default => t("helpers.links.back")),
              artifacts_path, :class => 'btn btn-secondary' %>
<%= link_to t('.edit', :default => t("helpers.links.edit")),
              edit_artifact_path(@artifact), :class => 'btn btn-secondary' %>
<%= link_to t('.destroy', :default => t("helpers.links.destroy")),
              artifact_path(@artifact),
              :method => 'delete',
              :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
