<%= form_for @artifact,
      html: { class: "artifact", multipart: true } do |f| %>

  <% if @artifact.errors.any? %>
    <div class="alert alert-danger">
      <h5 class="alert-heading">
        <%= pluralize(@artifact.errors.count, "error") %>
        prohibited this artifact from being saved:
      </h5>

      <hr>

      <ul class="mb-0">
        <% @artifact.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= f.label :key, 'Upload File', class: 'form-label' %>
    <%= f.file_field :key, class: 'form-control' %>
  </div>

  <%= f.hidden_field :company_project_id,
      value: @artifact.company_project_id %>

  <div class="mb-3">

    <%= f.submit nil, class: 'btn btn-primary' %>

    <%= link_to "Cancel",
        artifacts_path,
        class: 'btn btn-secondary' %>

  </div>

<% end %>